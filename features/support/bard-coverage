#!/usr/bin/env ruby
root = File.expand_path("../../..", __FILE__)

require "simplecov"
SimpleCov.root(root)
SimpleCov.start do
  command_name "Cucumber (subprocess #{$$})"
  cover "lib/**/*.rb"
  coverage_dir "#{root}/coverage"
end

$LOAD_PATH.unshift("#{root}/lib")
require "bard/cli"
# bard-cli discovers plugins from its own gem, the cwd's Gemfile.lock, and the cwd's lib.
# The acceptance suite runs from a temp project, so none of those find this checkout —
# load the commands under test explicitly.
require "bard/plugins/new"
Bard::CLI.start ARGV
